# SQLite is used by default for local development. Use persistent PostgreSQL for deployments.
# BIS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/bis_assist
BIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Uses the public BIS Know Your Standards keyword search at analysis time.
BIS_LIVE_SEARCH_ENABLED=true
# Set only to an already downloaded model. The app never downloads a model automatically.
# BIS_SBERT_MODEL_PATH=C:/models/all-MiniLM-L6-v2
